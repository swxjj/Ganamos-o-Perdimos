{
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python",
      "config": { "includeFiles": ["ponderaciones.xlsx"] }
    },
    { "src": "public/**",    "use": "@vercel/static"  },
    { "src": "index.html",   "use": "@vercel/static"  }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/index.py" },
    { "src": "/api",      "dest": "/api/index.py" },
    { "src": "/",         "dest": "/public/index.html" },
    { "src": "/(.*)",     "dest": "/public/$1" }
  ]
}
